---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
   (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang='en'>
   <head>
      <BaseHead title='全部博客' description={SITE_DESCRIPTION} />
      <style>
         :root {
            background: #181818;
         }
         main {
            width: 900px;
            min-height: 90vh;
         }
         ul {
            display: flex;
            flex-wrap: wrap;
            gap: 2rem;
            list-style-type: none;
            margin: 0;
            padding: 0;
         }
         ul > div {
            position: relative;
            width: 100%;
            transition: 0.2s ease;
         }
         ul > div:hover {
            filter: drop-shadow(0 0.5rem 0.5rem #ff7b002d);
         }
         ul li {
            position: relative;
            width: 100%;
            background-size: 50%;
            background-position: right;
            border-left: 0.4rem #ff7b00 solid !important;
            background-repeat: no-repeat;
            clip-path: polygon(
               0 0,
               100% 0,
               100% calc(100% - 2rem),
               calc(100% - 2rem) 100%,
               0 100%
            );
         }
         ul li * {
            text-decoration: none;
            transition: 0.2s ease;
            overflow: hidden;
         }
         ul li a {
            width: 100%;
            padding: 1.5rem 1rem;
            z-index: 100;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            padding-left: 3rem;
            transition: 0.2s ease;
         }
         ul li:hover a {
            transform: translateX(1rem);
         }
         .mask {
            position: absolute;
            background: linear-gradient(
               to right,
               #181818 50%,
               #181818a9 75%,
               transparent 100%
            );
            width: 100%;
            height: 100%;
         }
         .title {
            width: 100%;
            margin: 0;
            color: rgb(var(--black));
            line-height: 1;

            &::before {
               display: none;
            }
         }
         .desc {
            position: relative;
            margin: 0;
            color: rgb(var(--gray));
            text-overflow: ellipsis;
            overflow: hidden;
            line-clamp: 2;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
         }
         .date {
            width: 100%;
            position: relative;
            margin: 0;
            color: rgb(var(--gray));
         }
         .tag {
            position: absolute;
            bottom: 0;
            right: 0;
            width: 2rem;
            height: 2rem;
            background: #ff7b00;
            clip-path: polygon(
               100% 0.45rem,
               100% 0.85rem,
               0.85rem 100%,
               0.45rem 100%
            );
         }
         ul li a:hover h4,
         ul li a:hover .date {
            color: rgb(var(--accent));
         }
         ul a:hover img {
            box-shadow: var(--box-shadow);
         }
         @media (max-width: 720px) {
            ul li a {
               padding-block: 1.1rem;
               padding-left: 1.5rem;
               gap: 0.8rem;
            }
            ul li {
               background-size: 100%;
            }
         }
         .smoothIn {
            animation: smoothIn 0.5s ease forwards;
         }
         @keyframes smoothIn {
            from {
               opacity: 0;
               transform: translateX(-2rem);
            }
            to {
               opacity: 1;
               transform: translateY(0);
            }
         }
      </style>
      <script>
         window.onload = () => {
            scrollTo(0, 0);
         };
      </script>
   </head>
   <body class='flex flex-col items-center'>
      <Header />
      <main class='my-20'>
         <section>
            <ul>
               {
                  posts.map((post, idx) => (
                     <div
                        class='smoothIn'
                        style={{
                           opacity: 0,
                           animationDelay: `${idx * 0.2}s`,
                        }}>
                        <div class='tag' />
                        <li
                           style={{
                              backgroundImage: `url(${post.data.heroImage})`,
                           }}>
                           <div class='mask' />
                           <a href={`/blog/${post.id}/`}>
                              <h4 class='title'>{post.data.title}</h4>
                              <p class='desc' title={post.data.description}>
                                 {post.data.description}
                              </p>
                              <p class='date'>
                                 <FormattedDate date={post.data.pubDate} />
                              </p>
                           </a>
                        </li>
                     </div>
                  ))
               }
            </ul>
         </section>
      </main>
      <Footer />
   </body>
</html>

---
import BaseHead from '../components/BaseHead.astro';
import Home from '../components/home/Home';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang='en'>
   <head>
      <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} noSuffix />
      <style>
         body {
            background: #181818;
         }
      </style></head
   >

   <body class='flex items-center flex-col overflow-y-auto overflow-x-hidden'>
      <Header />
      <Home client:load />
      <Footer opacity={0.5} />
   </body>
</html>

---
export interface Props {
   currentPage: number;
   pageNum: number;
   basePath: string;
}

const { currentPage, pageNum, basePath } = Astro.props;
---

<style>
   .pagination__container {
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.75rem;
      margin-top: 3rem;
      height: 6rem;
   }

   .pagination__item {
      position: relative;
      width: 2rem;
      height: 2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid #ff7b00;
      z-index: 3;
   }

   .pagination__item::before {
      content: '';
      position: absolute;
      width: 110%;
      height: 110%;
      background: #ff7b00;
      z-index: 0;
      opacity: 0;
      filter: blur(1rem);
      transition: opacity 0.3s;
   }

   .pagination__item:hover::before {
      opacity: 0.35;
   }

   .active {
      font-weight: bold;
      background: #ff7b00;
      color: #181818;
      --corner: 0.4rem;
      clip-path: polygon(
         0 0,
         calc(100% - var(--corner)) 0,
         100% var(--corner),
         100% 100%,
         0 100%
      );
   }

   .pagination__container .btn {
      width: 2rem;
      height: 2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      border: 1px solid #ff7b00;
      cursor: pointer;
      background: #ff7b00;
      font-size: 1.2rem;
   }
</style>

<script>
   document.addEventListener('astro:page-load', () => {
      const container = document.querySelector(
         '.pagination__container'
      ) as HTMLDivElement;
      const currentPage = parseInt(container?.dataset?.current || '1');
      const basePath = container?.dataset?.base || '';

      function goto(offset: number) {
         const index = currentPage + offset;
         window.location.href =
            index === 1 ? basePath : `${basePath}/${currentPage + offset}`;
      }

      document
         .querySelector('.prev')
         ?.addEventListener('click', () => goto(-1));
      document.querySelector('.next')?.addEventListener('click', () => goto(1));
   });
</script>

<div
   class='pagination__container'
   data-current={currentPage}
   data-base={basePath}>
   {
      currentPage > 1 && (
         <div class='prev btn'>
            <i class='fas fa-caret-left' />
         </div>
      )
   }
   <a
      class={'pagination__item ' + (currentPage === 1 ? 'active' : '')}
      href={basePath}>
      1
   </a>
   {
      Array.from({ length: pageNum - 1 }, (_, i) => i + 2).map((page) => (
         <a
            href={`${basePath}/${page}`}
            class={
               'pagination__item ' + (currentPage === page ? 'active' : '')
            }>
            {page}
         </a>
      ))
   }
   {
      currentPage < pageNum && (
         <div class='next btn'>
            <i class='fas fa-caret-right' />
         </div>
      )
   }
</div>
